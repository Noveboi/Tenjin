# https://EditorConfig.org

# top-most EditorConfig file. Used for all projects in the monorepo.
# Projects can define their own `.editorconfig` files to further enforce code style.
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
